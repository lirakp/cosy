{
  "name": "cosy",
  "version": "0.1.0",
  "description": "Ein gemütliches Pixel-Art-Sammelspiel",
  "author": "Cosy",
  "private": true,
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "dist": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "app.cosy.game",
    "productName": "Cosy",
    "files": [
      "index.html",
      "style.css",
      "src/**/*",
      "icons/**/*",
      "manifest.webmanifest",
      "desktop/**/*"
    ],
    "directories": {
      "buildResources": "build"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "artifactName": "Cosy-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "Cosy-${version}-portable.exe"
    }
  },
  "type": "module"
}
